---
// Témoignages rendus en HTML statique (crawlables par Google), le JS ne fait
// que la pagination. Avatars en initiales : pas de photos de banque d'images
// associées à des identités clients (risque E-E-A-T).
const slides = [
  [
    { quote: "Paul a créé notre site web et optimisé notre référencement. Résultat : plus de visibilité et plus de clients. Je recommande !", name: 'Sophie Martin', role: 'Fondatrice, Bloom Studio' },
    { quote: "Grâce à son audit SEO, nous avons doublé notre trafic en 3 mois. Professionnel et à l'écoute.", name: 'Thomas Bernard', role: 'CEO, Agence B7' },
    { quote: "Un vrai partenaire digital. Paul comprend nos besoins et propose toujours les meilleures solutions.", name: 'Julie Durand', role: 'Responsable Marketing, Orium' },
  ],
  [
    { quote: "Une refonte complète menée avec rigueur et créativité. Notre nouveau site convertit deux fois mieux.", name: 'Marc Lefèvre', role: 'Directeur, Cabinet Lefèvre' },
    { quote: "Paul a transformé notre stratégie SEO. Plus de leads qualifiés, moins de budget pub. Magique.", name: 'Camille Roux', role: 'Co-fondatrice, Atelier Roux' },
    { quote: "Disponible, pédagogue et orienté résultats. Un vrai plaisir de travailler avec lui sur la durée.", name: 'Antoine Petit', role: 'Gérant, Boutique Petit' },
  ],
  [
    { quote: "Performances techniques au top, page speed parfait. Le SEO suit naturellement.", name: 'Léa Moreau', role: 'CMO, Studio Moreau' },
    { quote: "Site e-commerce livré dans les délais et au-dessus de mes attentes. Bravo Paul.", name: 'Nicolas Garcia', role: 'Fondateur, Maison Garcia' },
    { quote: "Conseil SEO précis et actionnable. On a vu les résultats dès le premier mois.", name: 'Émilie Dubois', role: 'Resp. Digital, Groupe Dubois' },
  ],
]

const initials = (name: string) =>
  name.split(' ').map(p => p[0]).join('').toUpperCase()
---

<section class="testimonials">
  <div class="wrap">
    <p class="section-eyebrow">Témoignages</p>
    <h2 class="section-title">Ils me font confiance</h2>
    {slides.map((slide, i) => (
      <div class={`testi-grid${i === 0 ? ' is-active' : ''}`} data-slide={i}>
        {slide.map(t => (
          <div class="testi">
            <div class="quote-mark">"</div>
            <p class="quote">{t.quote}</p>
            <div class="testi-author">
              <span class="testi-avatar" aria-hidden="true">{initials(t.name)}</span>
              <div>
                <div class="author-name">{t.name}</div>
                <div class="author-role">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ))}
    <div class="dots" id="dots">
      <button class="dot active" data-slide="0" aria-label="Page 1"></button>
      <button class="dot" data-slide="1" aria-label="Page 2"></button>
      <button class="dot" data-slide="2" aria-label="Page 3"></button>
    </div>
  </div>
</section>

<style>
  /* Pagination sans JS de rendu : tous les témoignages sont dans le HTML,
     seule la grille active est affichée. */
  .testi-grid { display: none; }
  .testi-grid.is-active { display: grid; }
  .testi-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .02em;
    flex-shrink: 0;
  }
</style>

<script>
  const grids = document.querySelectorAll<HTMLElement>('.testi-grid[data-slide]')
  document.querySelectorAll<HTMLElement>('.dot').forEach(dot => {
    dot.addEventListener('click', () => {
      document.querySelectorAll('.dot').forEach(d => d.classList.remove('active'))
      dot.classList.add('active')
      const index = dot.dataset.slide
      grids.forEach(g => g.classList.toggle('is-active', g.dataset.slide === index))
    })
  })
</script>
